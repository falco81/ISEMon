diff -ruN raddb/modules/linelog raddb.new/modules/linelog
--- a/modules/linelog	2017-07-18 14:13:48.000000000 +0200
+++ b/modules/linelog	2026-09-26 10:56:56.275147688 +0200
@@ -103,3 +103,32 @@
 	}
 
 }
+
+#
+#  Second instance: one-line accounting log.
+#  NOTE: for accounting the "reference" MUST point at the
+#  Accounting-Request sub-section, otherwise nothing is logged.
+#
+linelog linelog_acct {
+	filename = ${logdir}/acct-linelog
+	permissions = 0600
+
+	format = "%t : acct %{%{Acct-Status-Type}:-unknown} user=%{User-Name}"
+
+	reference = "Accounting-Request.%{%{Acct-Status-Type}:-unknown}"
+
+	Accounting-Request {
+		Start = "%t : START user=[%{User-Name}] nas=%{Packet-Src-IP-Address} nas-id=%{NAS-Identifier} port=%{NAS-Port} porttype=%{NAS-Port-Type} cli=%{Calling-Station-Id} did=%{Called-Station-Id} fip=%{Framed-IP-Address} session=%{Acct-Session-Id} mcid=%{Acct-Multi-Session-Id}"
+
+		Interim-Update = "%t : ALIVE user=[%{User-Name}] nas=%{Packet-Src-IP-Address} session=%{Acct-Session-Id} time=%{Acct-Session-Time}s in=%{Acct-Input-Octets} out=%{Acct-Output-Octets}"
+
+		Alive = "%t : ALIVE user=[%{User-Name}] nas=%{Packet-Src-IP-Address} session=%{Acct-Session-Id} time=%{Acct-Session-Time}s in=%{Acct-Input-Octets} out=%{Acct-Output-Octets}"
+
+		Stop = "%t : STOP  user=[%{User-Name}] nas=%{Packet-Src-IP-Address} port=%{NAS-Port} cli=%{Calling-Station-Id} fip=%{Framed-IP-Address} session=%{Acct-Session-Id} time=%{Acct-Session-Time}s in=%{Acct-Input-Octets} out=%{Acct-Output-Octets} cause=%{Acct-Terminate-Cause}"
+
+		Accounting-On  = "%t : NAS-ON  nas=%{Packet-Src-IP-Address} nas-ip=%{NAS-IP-Address} nas-id=%{NAS-Identifier}"
+		Accounting-Off = "%t : NAS-OFF nas=%{Packet-Src-IP-Address} nas-ip=%{NAS-IP-Address} nas-id=%{NAS-Identifier}"
+
+		unknown = "%t : acct-UNKNOWN type=%{Acct-Status-Type} user=[%{User-Name}] nas=%{Packet-Src-IP-Address} session=%{Acct-Session-Id}"
+	}
+}
