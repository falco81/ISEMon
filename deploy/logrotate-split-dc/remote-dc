# /etc/logrotate.d/remote-dc
#
# Rotace logů z AD řadičů. Vysoký objem (~2,8 GB/den na dc10), proto
# oddělené od ostatních zdrojů — ale běží pod standardním systémovým
# logrotate.timer, žádná vlastní služba není potřeba.
#
# Adresáře dc*/dct* MUSÍ být vyjmuté z /etc/logrotate.d/remote-logs,
# jinak logrotate skončí chybou "duplicate log entry".

/var/log/remote/dc10/*.log
/var/log/remote/dc11/*.log
/var/log/remote/dc14/*.log
/var/log/remote/dc16/*.log
/var/log/remote/dct01/*.log
/var/log/remote/dct02/*.log
{
    daily
    dateext
    rotate 30

    compress
    # gzip -6 poběží na 3GB souboru řádově minuty. Pokud vadí, nainstalujte
    # zstd (dnf install zstd) a odkomentujte následující čtyři řádky —
    # je to jen jiný binárník, žádná služba navíc.
    #compresscmd /usr/bin/zstd
    #uncompresscmd /usr/bin/unzstd
    #compressext .zst
    #compressoptions -3 -T4 --rm

    # Pojistka pro případ, že by rsyslog ještě dopisoval do starého
    # deskriptoru. Daň: vedle sebe držíte aktivní i předchozí
    # nekomprimovaný soubor, tedy ~3 GB navíc na velký řadič.
    # Při potvrzeně funkčním reloadu lze nahradit za nodelaycompress.
    delaycompress

    missingok
    notifempty
    create 0640 root isemon

    sharedscripts
    postrotate
        # Bez "|| true" a bez zahazování výstupu — selhání reloadu musí
        # být vidět, jinak rsyslog píše dál do přejmenovaného inode.
        # Debian's rsyslog has no reload: HUP straight to it there (1.10.197).
        /usr/bin/systemctl reload rsyslog > /dev/null 2>&1 || \
            /usr/bin/systemctl kill -s HUP --kill-who=main rsyslog.service > /dev/null 2>&1 || true
    endscript
}
