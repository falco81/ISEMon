# /etc/systemd/system/isemon-web.path (1.10.222)
#
# Watches for what Settings asked of root: the daemon lays request.json (a
# change to nginx or the firewall) or look.ask (a look at how things are)
# down in /var/lib/isemon/web/ - or net.ask / ntp.ask (1.10.228: this server's
# network, a restart, its clock), sshkeys.ask (1.10.239: the keys root signs
# in with) or osup.ask (1.10.239: a look for updates of the operating system,
# or the update, which root starts as a unit of its own) - and this starts
# isemon-web.service, which checks it as root and puts it in. Nothing else
# can be asked for this way.
[Unit]
Description=isemon - the firewall, who may reach which page and TLS, asked for on the pages

[Path]
PathExists=/var/lib/isemon/web/request.json
PathExists=/var/lib/isemon/web/look.ask
PathExists=/var/lib/isemon/web/net.ask
PathExists=/var/lib/isemon/web/ntp.ask
PathExists=/var/lib/isemon/web/sshkeys.ask
PathExists=/var/lib/isemon/web/osup.ask
Unit=isemon-web.service

[Install]
WantedBy=multi-user.target
